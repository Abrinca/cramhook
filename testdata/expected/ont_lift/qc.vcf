##FILTER=<ID=LowCov,Description="DP < 20: too few reads to trust the call">
##INFO=<ID=TIER,Number=1,Type=String,Description="What the reads show: RED, ORANGE, YELLOW or GRAY (homopolymer indel, below yellow)">
##INFO=<ID=TYPE,Number=1,Type=String,Description="SNP, INS or DEL">
##INFO=<ID=AF,Number=A,Type=Float,Description="Alt reads / DP">
##INFO=<ID=DP,Number=1,Type=Integer,Description="Reads with a base or a deletion at the position (unlike bcftools, deletions are counted); secondary, duplicate and QC-fail records excluded, supplementary included">
##INFO=<ID=AD,Number=R,Type=Integer,Description="Ref and alt read counts (indel ref = DP minus all indel alleles at the anchor)">
##INFO=<ID=ADF,Number=R,Type=Integer,Description="Ref and alt read counts, forward strand">
##INFO=<ID=ADR,Number=R,Type=Integer,Description="Ref and alt read counts, reverse strand">
##INFO=<ID=DP4,Number=4,Type=Integer,Description="Ref-forward, ref-reverse, alt-forward, alt-reverse reads">
##INFO=<ID=HP,Number=1,Type=Integer,Description="Homopolymer run length (SNP: run containing the position; indel: run starting after the anchor)">
##INFO=<ID=STR,Number=1,Type=Integer,Description="Tandem-repeat span (period 2-4, >= 3 copies) at the position / after the anchor; 0 if none">
##INFO=<ID=CLASS,Number=1,Type=String,Description="Background class used for the test">
##INFO=<ID=PV,Number=1,Type=Float,Description="Beta-binomial upper-tail p-value against the class background">
##INFO=<ID=QV,Number=1,Type=Float,Description="Benjamini-Hochberg q-value (m = assessable positions of the class)">
##INFO=<ID=MQ0F,Number=1,Type=Float,Description="Share of MAPQ 0 reads in DP">
##INFO=<ID=MIXED,Number=0,Type=Flag,Description="Alt fraction in the mixed band">
##INFO=<ID=HPGRAY,Number=0,Type=Flag,Description="Gray: a minority/strand-biased yellow INS/DEL in a homopolymer >= --gray-hp-min (TIER=GRAY; not counted in red/orange/yellow)">
##INFO=<ID=STRAND,Number=0,Type=Flag,Description="Strand-balance gate failed">
##INFO=<ID=LOWCOV,Number=0,Type=Flag,Description="Low coverage: DP < 20 (abs) or DP < 0.25 x the contig depth mode (rel); only abs sets FILTER=LowCov">
##INFO=<ID=LINKED,Number=1,Type=Integer,Description="Haplotype group id from the linkage second pass">
##INFO=<ID=UNLINKED,Number=0,Type=Flag,Description="Tested against >= 2 partner sites within the linkage window and linked to none">
##INFO=<ID=GROUPED,Number=1,Type=Integer,Description="Exact insertion alleles merged into this candidate (only when > 1)">
##INFO=<ID=ORIGIN,Number=0,Type=Flag,Description="Indel before the first reference base (right-padded: anchor base is the last REF/ALT base)">
##INFO=<ID=REASON,Number=1,Type=String,Description="Tier rule that fired">
##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype (haploid)">
##FORMAT=<ID=AD,Number=R,Type=Integer,Description="Ref and alt read counts">
##FORMAT=<ID=DP,Number=1,Type=Integer,Description="Depth as INFO/DP">
